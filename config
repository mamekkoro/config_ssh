# ~/.ssh/config
#
# OpenSSH reads these files in lexical order. Host-specific settings come
# before defaults because OpenSSH uses the first value it obtains.
Include ~/.ssh/config.d/20-tailscale.conf
Include ~/.ssh/config.d/30-public-vps.conf
Include ~/.ssh/config.d/90-common.conf
Include ~/.ssh/config.d/95-macos.conf
